<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the main manifest for the github build (the APK from Mind / GitHub releases). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app ask to be exempt from battery optimisation, so alerts are never held back. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Self-update from GitHub releases (Updater.kt); the user allows it once. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <receiver
            android:name=".Updater$InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
